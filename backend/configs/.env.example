# ============================================================
# 家具销售提成管理系统 - 环境变量配置示例
# ============================================================
# 复制此文件为 .env 并修改实际值
# 生产环境务必修改所有含 "change-me" 的值
# ============================================================

# ---- 服务器配置 ----
SERVER_PORT=8082
GIN_MODE=release

# ---- 数据库配置 ----
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=furniture_app
DB_PASSWORD=change-me-to-strong-password
DB_NAME=furniture_commission
DB_MAX_IDLE_CONNS=10
DB_MAX_OPEN_CONNS=100

# ---- JWT 认证 ----
# 生产环境务必生成高强度随机密钥（建议 openssl rand -base64 64）
JWT_SECRET=change-me-to-random-secret-at-least-64-chars
JWT_EXPIRE_HOURS=24

# ---- 日志配置 ----
LOG_LEVEL=info
LOG_FILE=logs/app.log

# ---- CORS 跨域配置 ----
CORS_ORIGIN_1=https://your-domain.com
CORS_ORIGIN_2=http://localhost:8082
CORS_ORIGIN_3=

# ---- 文件上传 ----
UPLOAD_DIR=./uploads
UPLOAD_BASE_URL=https://your-domain.com/uploads
